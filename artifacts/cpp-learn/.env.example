# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
#
# IMPORTANT: For production deployment on Netlify:
# 1. DO NOT commit your .env file to git (it's in .gitignore)
# 2. Set these variables in Netlify Dashboard:
#    - Go to Site settings > Environment variables
#    - Add each variable there (not in .env file)
# 3. For local development, copy this file to .env and fill in your values
#
# ============================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
# 1. Go to your Supabase project dashboard
# 2. Click on "Project Settings" (gear icon)
# 3. Go to "API" section
# 4. Copy the "Project URL" and "anon public" key

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin email - user with this email will automatically get admin role
# Change this to your admin email address
VITE_ADMIN_EMAIL=

# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# LOCAL DEVELOPMENT:
# 1. Copy .env.example to .env
# 2. Fill in your Supabase credentials
# 3. Run `npm run dev`
#
# NETLIFY DEPLOYMENT:
# 1. Do NOT set environment variables in .env file
# 2. Go to Netlify Dashboard > Your Site > Site settings
# 3. Click "Environment variables" in the sidebar
# 4. Add the following variables:
#    - VITE_SUPABASE_URL (your Supabase project URL)
#    - VITE_SUPABASE_ANON_KEY (your Supabase anon key)
#    - VITE_ADMIN_EMAIL (your admin email)
# 5. Trigger a new deploy (the app will automatically rebuild)
#
# If these variables are not set or invalid, the app will show
# a blank page or loading spinner. Check browser console for errors.
#
# ============================================