// SQLite Schema - Temporary for local development
// Switch to schema.prisma when PostgreSQL connection works

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Roles as String (SQLite doesn't have enums)
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  role              String   @default("STUDENT") // STUDENT, ADMIN, MODERATOR
  avatar            String?
  bio               String?
  xp                Int      @default(0)
  level             Int      @default(1)
  streak            Int      @default(0)
  lastActiveAt      DateTime @default(now())
  isEmailVerified   Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  progresses        Progress[]
  enrollments       Enrollment[]
  subscriptions     Subscription[]
  payments          Payment[]
  challengeAttempts ChallengeAttempt[]
  certificates      Certificate[]

  @@map("User")
}

model Topic {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  description       String
  shortDescription  String?
  difficulty        String   // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedHours    Int
  thumbnail         String?
  isPublished       Boolean  @default(false)
  isFree            Boolean  @default(false)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  modules           Module[]
  enrollments       Enrollment[]

  @@map("Topic")
}

model Module {
  id                String   @id @default(uuid())
  topicId           String
  title             String
  slug              String
  description       String?
  orderIndex        Int      @default(0)
  isPublished       Boolean  @default(true)
  estimatedMinutes  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  topic             Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessons           Lesson[]

  @@unique([topicId, slug])
  @@map("Module")
}

model Lesson {
  id                String   @id @default(uuid())
  moduleId          String
  title             String
  slug              String
  content           String
  estimatedMinutes  Int      @default(30)
  orderIndex        Int      @default(0)
  isPublished       Boolean  @default(true)
  isFree            Boolean  @default(false)
  videoUrl          String?
  resources         String?  // JSON as string
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module            Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses        Progress[]
  challenges        Challenge[]

  @@unique([moduleId, slug])
  @@map("Lesson")
}

model Progress {
  id                String   @id @default(uuid())
  userId            String
  lessonId          String
  status            String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  progressPercent   Int      @default(0)
  timeSpentMinutes  Int      @default(0)
  lastAccessedAt    DateTime @default(now())
  completedAt       DateTime?
  xpEarned          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("Progress")
}

model Enrollment {
  id                String   @id @default(uuid())
  userId            String
  topicId           String
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  progressPercent   Int      @default(0)
  enrolledAt        DateTime @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic             Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("Enrollment")
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  status            String   @default("FREE") // FREE, TRIAL, PREMIUM, PRO, CANCELLED, EXPIRED
  plan              String   @default("FREE") // FREE, MONTHLY, YEARLY
  startDate         DateTime @default(now())
  endDate           DateTime?
  autoRenew         Boolean  @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Subscription")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  amount            Float
  currency          String   @default("ZAR")
  status            String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod     String   // PAYFAST, CARD, EFT
  transactionId     String?
  metadata          String?  // JSON as string
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Payment")
}

model Challenge {
  id                String   @id @default(uuid())
  lessonId          String
  title             String
  description       String
  difficulty        String   // EASY, MEDIUM, HARD
  points            Int      @default(10)
  testCases         String   // JSON as string
  starterCode       String?
  solution          String?
  hints             String?  // JSON as string
  orderIndex        Int      @default(0)
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts          ChallengeAttempt[]

  @@map("Challenge")
}

model ChallengeAttempt {
  id                String   @id @default(uuid())
  userId            String
  challengeId       String
  code              String
  language          String
  status            String   // PENDING, PASSED, FAILED
  testsPassed       Int      @default(0)
  testsTotal        Int      @default(0)
  executionTime     Int?
  memory            Int?
  feedback          String?
  createdAt         DateTime @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge         Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("ChallengeAttempt")
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  title             String
  description       String?
  issueDate         DateTime @default(now())
  certificateUrl    String?
  verificationCode  String   @unique
  metadata          String?  // JSON as string
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Certificate")
}
