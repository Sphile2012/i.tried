# ============================================================
# EXAMPLE: Supabase Database Configuration
# ============================================================
#
# Copy your Supabase connection string here and this is what
# your .env file should look like
#
# How to get your Supabase connection string:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Click Settings → Database
# 4. Find "Connection String" section
# 5. Select "URI" format
# 6. Copy the string
# 7. Replace [YOUR-PASSWORD] with your actual database password
#
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration - SUPABASE
# Replace the entire line below with your Supabase connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxxx.supabase.co:5432/postgres?schema=public

# Example (DO NOT USE - replace with your actual connection string):
# DATABASE_URL=postgresql://postgres:mySecurePassword123@db.abcdefghijklmnop.supabase.co:5432/postgres?schema=public

# JWT Configuration
JWT_SECRET=infinity_code_super_secret_jwt_key_2024_change_in_production_xyz123
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=infinity_code_refresh_secret_2024_xyz456
JWT_REFRESH_EXPIRES_IN=30d

# PayFast Configuration (Sandbox for testing)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=test_passphrase
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=http://localhost:5173/subscription?status=success
PAYFAST_CANCEL_URL=http://localhost:5173/subscription?status=cancelled
PAYFAST_NOTIFY_URL=http://localhost:3001/api/payments/payfast/itn

# Email Configuration (Optional for now)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME="Infinity Code"
EMAIL_FROM_ADDRESS=noreply@infinitecode.co.za

# AI Configuration (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Frontend URL
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
